# FusionAI Enterprise Suite — Production Environment Variables
# Copy to .env.production and fill in real values. NEVER commit this file.

# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0

# ── Database ─────────────────────────────────────────────────
DB_NAME=fusionai
DB_USER=fusionai
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_64_char_random_string
SESSION_SECRET=CHANGE_ME_min_64_char_random_string

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=https://app.fusionai.example.com

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Observability ────────────────────────────────────────────
SENTRY_DSN=https://...@o0.ingest.sentry.io/...
VITE_SENTRY_DSN=https://...@o0.ingest.sentry.io/...   # frontend Sentry DSN
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_ENDPOINT=http://otel-collector:4318/v1/traces

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_grafana_admin_password
GRAFANA_URL=https://grafana.fusionai.example.com

# ── Nginx / TLS ──────────────────────────────────────────────
NGINX_HOST=app.fusionai.example.com
SSL_CERT_PATH=/etc/letsencrypt/live/app.fusionai.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/app.fusionai.example.com/privkey.pem

# ── Backup ───────────────────────────────────────────────────
BACKUP_BUCKET=s3://fusionai-backups-prod

# ── Vite (frontend build args) ───────────────────────────────
VITE_API_URL=https://app.fusionai.example.com
