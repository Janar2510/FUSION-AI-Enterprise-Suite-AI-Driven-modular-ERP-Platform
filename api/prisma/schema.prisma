generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 1 — Canonical Domain Spine (ADR-0004)
// These models are the platform-level shared entities. Every module references
// them; no module duplicates them.
// Migration: run `prisma migrate dev --name init_spine` after Phase 1 review.
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  status    OrgStatus    @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  companies SpineCompany[]
  users     SpineUser[]
  roles     SpineRole[]  @relation("OrgRoles")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model SpineCompany {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  legalName       String?
  vatId           String?
  currencyCode    String       @default("EUR")
  countryCode     String       @default("EE")
  fiscalYearStart Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
}

model SpineUser {
  id             String          @id @default(cuid())
  organizationId String
  companyId      String?
  name           String          @default("")
  email          String          @unique
  passwordHash   String?
  active         Boolean         @default(true)
  mfaEnabled     Boolean         @default(false)
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id])
  userRoles      SpineUserRole[]
  aiActions      AiAction[]      @relation("TriggeredBy")
  approvedActions AiAction[]     @relation("ApprovedBy")

  @@index([organizationId])
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model SpineRole {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  organizationId  String?
  description     String?
  organization    Organization?        @relation("OrgRoles", fields: [organizationId], references: [id])
  userRoles       SpineUserRole[]
  rolePermissions SpineRolePermission[]
}

model SpinePermission {
  id              String               @id @default(cuid())
  key             String               @unique
  description     String?
  rolePermissions SpineRolePermission[]
}

model SpineUserRole {
  userId String
  roleId String
  user   SpineUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   SpineRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model SpineRolePermission {
  roleId       String
  permissionId String
  role         SpineRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   SpinePermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SpinePartnerAddress {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])
  type      String
  street1   String?
  street2   String?
  city      String?
  state     String?
  zip       String?
  country   String?
}

model SpinePartnerContact {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])
  kind      String
  value     String
  isPrimary Boolean @default(false)
}

model Attachment {
  id             String   @id @default(cuid())
  organizationId String
  ownerType      String
  ownerId        String
  filename       String
  contentType    String
  sizeBytes      Int
  storageKey     String
  checksumSha256 String
  uploadedById   String
  createdAt      DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([organizationId])
}

model SpineDocument {
  id             String   @id @default(cuid())
  organizationId String
  partnerId      String?
  attachmentId   String   @unique
  kind           String
  status         String   @default("draft")
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

model Activity {
  id             String    @id @default(cuid())
  organizationId String
  ownerType      String
  ownerId        String
  type           String
  summary        String
  body           String?
  dueAt          DateTime?
  doneAt         DateTime?
  assignedToId   String?
  createdById    String
  createdAt      DateTime  @default(now())

  @@index([ownerType, ownerId])
  @@index([organizationId])
}

model ChatterMessage {
  id             String   @id @default(cuid())
  organizationId String
  ownerType      String
  ownerId        String
  authorId       String?
  body           String
  isInternal     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([organizationId])
}

model TimelineEvent {
  id             String   @id @default(cuid())
  organizationId String
  partnerId      String?
  ownerType      String
  ownerId        String
  eventKey       String
  summary        String
  payload        Json?
  createdAt      DateTime @default(now())

  @@index([partnerId])
  @@index([ownerType, ownerId])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

model OutboxEvent {
  id             String    @id @default(cuid())
  organizationId String
  eventKey       String
  payload        Json
  publishedAt    DateTime?
  attempts       Int       @default(0)
  lastError      String?
  createdAt      DateTime  @default(now())

  @@index([publishedAt])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 complete: Partner upgraded to canonical spine (ADR-0004)
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id                  String                @id @default(cuid())
  organizationId      String
  companyId           String?
  name                String
  email               String?
  phone               String?
  mobile              String?
  website             String?
  vat                 String?
  isCompany           Boolean               @default(false)
  isEmployee          Boolean               @default(false)
  isCustomer          Boolean               @default(false)
  isVendor            Boolean               @default(false)
  consentMarketing    Boolean               @default(false)
  consentUpdatedAt    DateTime?
  type                String                @default("contact")
  street              String?
  street2             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  title               String?
  jobPosition         String?
  notes               String?
  image               String?
  lang                String?               @default("en")
  color               Int                   @default(0)
  active              Boolean               @default(true)
  parentId            String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tags                PartnerToPartnerTag[]
  invoices            AccountMove[]         @relation("InvoicePartner")
  calendarEvents      CalendarAttendee[]
  crmLeads            CrmLead[]
  fsTasks             FsTask[]
  helpdeskTickets     HelpdeskTicket[]
  employeeLink        HrEmployee?
  parent              Partner?              @relation("CompanyContacts", fields: [parentId], references: [id])
  children            Partner[]             @relation("CompanyContacts")
  purchaseOrders      PurchaseOrder[]
  rentalOrders        RentalOrder[]
  saleOrders          SaleOrder[]
  subscriptions       Subscription[]
  pickings            StockPicking[]
  loyaltyCard         LoyaltyCard?
  passkeys            UserPasskey[]
  spreadsheets        Spreadsheet[]
  vendorPricelists    VendorPricelist[]
  spineAddresses      SpinePartnerAddress[]
  spineContacts       SpinePartnerContact[]
  payments            AccountPayment[]      @relation("PaymentPartner")
  paymentTermId       Int?
  paymentTerm         PaymentTerm?          @relation("PartnerPaymentTerm", fields: [paymentTermId], references: [id])
  pricelistId         Int?
  pricelist           Pricelist?            @relation("PartnerPricelist", fields: [pricelistId], references: [id])

  @@index([organizationId])
  @@map("partners")
}

model UserPasskey {
  id           Int      @id @default(autoincrement())
  partnerId    String
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id])

  @@map("user_passkeys")
}

model PartnerTag {
  id                  Int                   @id @default(autoincrement())
  name                String
  color               Int                   @default(0)
  PartnerToPartnerTag PartnerToPartnerTag[]

  @@map("partner_tags")
}

model CrmStage {
  id           Int       @id @default(autoincrement())
  name         String
  sequence     Int       @default(10)
  foldedKanban Boolean   @default(false)
  leads        CrmLead[]

  @@map("crm_stages")
}

model CrmTag {
  id    Int       @id @default(autoincrement())
  name  String
  color Int       @default(0)
  leads CrmLead[] @relation("CrmLeadToCrmTag")

  @@map("crm_tags")
}

model CrmLead {
  id              Int         @id @default(autoincrement())
  name            String
  type            String      @default("lead")
  active          Boolean     @default(true)
  priority        Int         @default(0)
  expectedRevenue Float       @default(0)
  probability     Float       @default(10)
  contactName     String?
  emailFrom       String?
  phone           String?
  mobile          String?
  street          String?
  city            String?
  state           String?
  zip             String?
  country         String?
  website         String?
  description     String?
  lostReason      String?
  color           Int         @default(0)
  organizationId  String?
  userId          String?     // salesperson (SpineUser.id)
  stageId         Int
  partnerId       String?
  dateDeadline    DateTime?
  dateClosed      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  partner         Partner?    @relation(fields: [partnerId], references: [id])
  stage           CrmStage    @relation(fields: [stageId], references: [id])
  saleOrders      SaleOrder[]
  tags            CrmTag[]        @relation("CrmLeadToCrmTag")
  activities      CrmActivity[]

  @@index([organizationId])
  @@index([userId])
  @@map("crm_leads")
}

// CRM Activities (calls, meetings, emails, deadlines)
model CrmActivity {
  id             Int       @id @default(autoincrement())
  leadId         Int
  lead           CrmLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type           String    // call | email | meeting | deadline | todo
  summary        String
  body           String?
  dueAt          DateTime?
  doneAt         DateTime?
  organizationId String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([leadId])
  @@index([organizationId])
  @@map("crm_activities")
}

model SaleOrder {
  id              Int             @id @default(autoincrement())
  name            String          @unique
  state           String          @default("draft")
  dateOrder       DateTime        @default(now())
  validityDate    DateTime?
  note            String?
  amountUntaxed   Float           @default(0)
  amountTax       Float           @default(0)
  amountTotal     Float           @default(0)
  organizationId  String?
  userId          String?         // salesperson (SpineUser.id)
  partnerId       String
  crmLeadId       Int?
  pricelistId     Int?            // optional pricelist override
  idempotencyKey  String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  invoices        AccountMove[]   @relation("SaleInvoices")
  lines           SaleOrderLine[]
  crmLead         CrmLead?        @relation(fields: [crmLeadId], references: [id])
  partner         Partner         @relation(fields: [partnerId], references: [id])
  pricelist       Pricelist?      @relation("SaleOrderPricelist", fields: [pricelistId], references: [id])
  pickings        StockPicking[]

  @@index([organizationId])
  @@map("sale_orders")
}

model SaleOrderLine {
  id            Int            @id @default(autoincrement())
  sequence      Int            @default(10)
  name          String
  productQty    Float          @default(1)
  priceUnit     Float          @default(0)
  discount      Float          @default(0)
  priceSubtotal Float          @default(0)
  priceTotal    Float          @default(0)
  isBillable    Boolean        @default(false)
  qtyDelivered  Float          @default(0)
  qtyInvoiced   Float          @default(0)
  orderId       Int
  productId     String?
  product       Product?       @relation(fields: [productId], references: [id])
  order         SaleOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  timesheets    HrTimesheet[]  @relation("TimesheetSaleOrderLine")

  @@map("sale_order_lines")
}

model PurchaseOrder {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  state          String              @default("draft")
  partnerRef     String?
  dateOrder      DateTime            @default(now())
  dateApprove    DateTime?
  datePlanned    DateTime?
  note           String?
  amountUntaxed  Float               @default(0)
  amountTax      Float               @default(0)
  amountTotal    Float               @default(0)
  organizationId String?
  partnerId      String
  idempotencyKey String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  lines          PurchaseOrderLine[]
  partner        Partner             @relation(fields: [partnerId], references: [id])
  pickings       StockPicking[]
  vendorBills    AccountMove[]       @relation("PurchaseBills")

  @@index([organizationId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            Int           @id @default(autoincrement())
  sequence      Int           @default(10)
  name          String
  productQty    Float         @default(1)
  qtyReceived   Float         @default(0)
  qtyInvoiced   Float         @default(0)
  priceUnit     Float         @default(0)
  priceSubtotal Float         @default(0)
  priceTotal    Float         @default(0)
  orderId       Int
  productId     String?
  product       Product?      @relation(fields: [productId], references: [id])
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model ProductCategory {
  id       Int               @id @default(autoincrement())
  name     String
  parentId Int?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

enum ProductType {
  STORABLE
  CONSUMABLE
  SERVICE
}

model Product {
  id              String              @id @default(cuid())
  organizationId  String?
  companyId       String?
  name            String
  internalRef     String?
  barcode         String?
  productType     ProductType         @default(CONSUMABLE)
  unitOfMeasure   String              @default("unit")
  salesPrice      Float               @default(0)
  costPrice       Float               @default(0)
  description     String?
  descriptionSale String?
  image           String?
  active          Boolean             @default(true)
  weight          Float               @default(0)
  volume          Float               @default(0)
  categoryId      Int?
  qtyOnHand       Float               @default(0)
  qtyForecasted   Float               @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invoiceLines    AccountMoveLine[]
  mrpLines        MrpBomLine[]
  mrpProductions  MrpProduction[]
  posLines        PosOrderLine[]
  category        ProductCategory?    @relation(fields: [categoryId], references: [id])
  purchaseLines   PurchaseOrderLine[]
  rentals         RentalOrderLine[]   @relation("RentalProductLink")
  saleLines       SaleOrderLine[]
  moves           StockMove[]
  quants          StockQuant[]
  qualityChecks   QualityCheck[]
  qualityPoints   QualityPoint[]
  qualityAlerts   QualityAlert[]
  mrpEcos         MrpEco[]
  mrpEcoLines     MrpEcoLine[]   @relation("EcoLineProduct")
  mrpScraps         MrpScrap[]
  subscriptionLines SubscriptionLine[]
  webCartItems    WebCartItem[]
  orderpoints     StockWarehouseOrderpoint[]
  vendorPricelists  VendorPricelist[]
  pricelistLines    PricelistLine[]  @relation("ProductPricelist")
  routes            StockRoute[]     @relation("ProductStockRoute")

  @@map("products")
}

model WebCart {
  id          Int            @id @default(autoincrement())
  sessionId   String         @unique
  customerId  Int?
  status      String         @default("active")
  subtotal    Float          @default(0)
  taxAmount   Float          @default(0)
  discount    Float          @default(0)
  totalAmount Float          @default(0)
  items       WebCartItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("web_carts")
}

model WebCartItem {
  id          Int      @id @default(autoincrement())
  cartId      Int
  productId   String
  productName String
  productSku  String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  lineTotal   Float    @default(0)
  cart        WebCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("web_cart_items")
}

model WebOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  saleOrderId  Int?
  cartId       Int?
  gatewayStatus String   @default("pending")
  createdAt    DateTime @default(now())

  @@map("web_orders")
}

model LoyaltyProgram {
  id              Int             @id @default(autoincrement())
  name            String
  pointsPerDollar Float           @default(1)
  active          Boolean         @default(true)
  cards           LoyaltyCard[]
  rewards         LoyaltyReward[]

  @@map("loyalty_programs")
}

model LoyaltyCard {
  id         Int            @id @default(autoincrement())
  programId  Int
  partnerId  String         @unique
  points     Float          @default(0)
  program    LoyaltyProgram @relation(fields: [programId], references: [id])
  partner    Partner        @relation(fields: [partnerId], references: [id])

  @@map("loyalty_cards")
}

model LoyaltyReward {
  id          Int            @id @default(autoincrement())
  name        String
  pointsCost  Float
  rewardType  String         @default("discount")
  programId   Int
  program     LoyaltyProgram @relation(fields: [programId], references: [id])

  @@map("loyalty_rewards")
}


model StockLocation {
  id               Int                @id @default(autoincrement())
  name             String
  completeName     String
  usage            String             @default("internal") // supplier, view, internal, customer, inventory, production, transit
  active           Boolean            @default(true)
  locationId       Int? // Parent location
  warehouseId      Int?
  companyId        Int?
  parent           StockLocation?     @relation("LocationHierarchy", fields: [locationId], references: [id])
  children         StockLocation[]    @relation("LocationHierarchy")
  warehouse        StockWarehouse?    @relation(fields: [warehouseId], references: [id])
  pickingsSrc      StockPicking[]     @relation("PickingSourceLocation")
  pickingsDest     StockPicking[]     @relation("PickingDestLocation")
  movesSrc         StockMove[]        @relation("MoveSourceLocation")
  movesDest        StockMove[]        @relation("MoveDestLocation")
  quants           StockQuant[]
  pickingTypesSrc  StockPickingType[] @relation("PickingTypeSourceLocation")
  pickingTypesDest StockPickingType[] @relation("PickingTypeDestLocation")
  orderpoints      StockWarehouseOrderpoint[]
  rulesSrc         StockRule[]        @relation("RuleSource")
  rulesDest        StockRule[]        @relation("RuleDest")

  @@map("stock_locations")
}

model StockWarehouse {
  id           Int                @id @default(autoincrement())
  name         String
  code         String             @unique
  active       Boolean            @default(true)
  locations    StockLocation[]
  pickings     StockPicking[]
  pickingTypes StockPickingType[]
  orderpoints  StockWarehouseOrderpoint[]

  @@map("stock_warehouses")
}

model StockPickingType {
  id                    Int             @id @default(autoincrement())
  name                  String
  code                  String // incoming, outgoing, internal
  sequenceCode          String
  warehouseId           Int?
  defaultLocationSrcId  Int?
  defaultLocationDestId Int?
  warehouse             StockWarehouse? @relation(fields: [warehouseId], references: [id])
  defaultLocationSrc    StockLocation?  @relation("PickingTypeSourceLocation", fields: [defaultLocationSrcId], references: [id])
  defaultLocationDest   StockLocation?  @relation("PickingTypeDestLocation", fields: [defaultLocationDestId], references: [id])
  pickings              StockPicking[]

  @@map("stock_picking_types")
}

model StockPicking {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  pickingTypeId   Int
  state           String    @default("draft")
  scheduledDate   DateTime?
  dateDone        DateTime?
  origin          String?
  note            String?
  locationId      Int?
  locationDestId  Int?
  partnerId       String?
  warehouseId     Int?
  saleOrderId     Int?
  purchaseOrderId Int?
  backorderId     Int?      // source picking this was created as backorder of
  returnId        Int?      // source picking this is a return of
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pickingType   StockPickingType @relation(fields: [pickingTypeId], references: [id])
  location      StockLocation?   @relation("PickingSourceLocation", fields: [locationId], references: [id])
  locationDest  StockLocation?   @relation("PickingDestLocation", fields: [locationDestId], references: [id])
  partner       Partner?         @relation(fields: [partnerId], references: [id])
  moves         StockMove[]
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  saleOrder     SaleOrder?       @relation(fields: [saleOrderId], references: [id])
  warehouse     StockWarehouse?  @relation(fields: [warehouseId], references: [id])
  qualityChecks QualityCheck[]

  @@map("stock_pickings")
}

model StockMove {
  id             Int      @id @default(autoincrement())
  name           String
  state          String   @default("draft")
  productQty     Float    @default(0) // Demand
  qtyDone        Float    @default(0) // Done
  locationId     Int
  locationDestId Int
  pickingId      Int?
  productId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location     StockLocation @relation("MoveSourceLocation", fields: [locationId], references: [id])
  locationDest StockLocation @relation("MoveDestLocation", fields: [locationDestId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  picking      StockPicking? @relation(fields: [pickingId], references: [id], onDelete: Cascade)

  @@map("stock_moves")
}

model StockQuant {
  id               Int      @id @default(autoincrement())
  productId        String
  locationId       Int
  quantity         Float    @default(0) // On Hand
  reservedQuantity Float    @default(0)
  inDate           DateTime @default(now())

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_quants")
}

model AccountAccount {
  id          Int               @id @default(autoincrement())
  name        String
  code        String            @unique
  accountType String
  reconcile   Boolean           @default(false)
  deprecated  Boolean           @default(false)
  active      Boolean           @default(true)
  lines       AccountMoveLine[]
  journals    AccountJournal[]  @relation("JournalDefaultAccount")

  @@map("account_accounts")
}

model AccountJournal {
  id               Int              @id @default(autoincrement())
  name             String
  code             String           @unique
  type             String
  active           Boolean          @default(true)
  defaultAccountId Int?
  defaultAccount   AccountAccount?  @relation("JournalDefaultAccount", fields: [defaultAccountId], references: [id])
  moves            AccountMove[]
  payments         AccountPayment[]

  @@map("account_journals")
}

model AccountMove {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  moveType        String
  state           String            @default("draft")
  date            DateTime          @default(now())
  dueDate         DateTime?
  ref             String?
  amountUntaxed   Float             @default(0)
  amountTax       Float             @default(0)
  amountTotal     Float             @default(0)
  amountResidual  Float             @default(0)
  paymentState    String            @default("not_paid")
  organizationId  String?
  journalId       Int
  partnerId       String?
  saleOrderId     Int?
  purchaseOrderId Int?
  idempotencyKey  String?           @unique
  postedAt        DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lines           AccountMoveLine[]
  payments        AccountPayment[]
  saleOrder       SaleOrder?        @relation("SaleInvoices", fields: [saleOrderId], references: [id])
  purchaseOrder   PurchaseOrder?    @relation("PurchaseBills", fields: [purchaseOrderId], references: [id])
  partner         Partner?          @relation("InvoicePartner", fields: [partnerId], references: [id])
  journal         AccountJournal    @relation(fields: [journalId], references: [id])

