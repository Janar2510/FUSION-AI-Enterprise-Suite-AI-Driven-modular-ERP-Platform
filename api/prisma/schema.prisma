// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5c — ERP Foundation: Payment Terms, Pricelists, Accounting Periods
// ─────────────────────────────────────────────────────────────────────────────

// G-08 — Payment terms (net-30, net-60, immediate, 50% upfront, etc.)
model PaymentTerm {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  note        String?
  active      Boolean           @default(true)
  lines       PaymentTermLine[]
  partners    Partner[]         @relation("PartnerPaymentTerm")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("payment_terms")
}

model PaymentTermLine {
  id              Int         @id @default(autoincrement())
  paymentTermId   Int
  paymentTerm     PaymentTerm @relation(fields: [paymentTermId], references: [id], onDelete: Cascade)
  sequence        Int         @default(10)
  value           String      @default("percent")  // percent | fixed | balance
  valueAmount     Float       @default(0)           // e.g. 100 for "100%"
  days            Int         @default(0)            // days from invoice date
  dayType         String      @default("after_invoice_date")

  @@index([paymentTermId])
  @@map("payment_term_lines")
}

// G-09 — Customer pricelist (partner-specific or tiered pricing)
model Pricelist {
  id            Int             @id @default(autoincrement())
  name          String
  currencyCode  String          @default("EUR")
  active        Boolean         @default(true)
  lines         PricelistLine[]
  partners      Partner[]       @relation("PartnerPricelist")
  saleOrders    SaleOrder[]     @relation("SaleOrderPricelist")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("pricelists")
}

model PricelistLine {
  id            Int        @id @default(autoincrement())
  pricelistId   Int
  pricelist     Pricelist  @relation(fields: [pricelistId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation("ProductPricelist", fields: [productId], references: [id])
  minQty        Float      @default(0)
  priceDiscount Float      @default(0)  // percent discount from sales price
  fixedPrice    Float?                  // override; null = use discount
  dateStart     DateTime?
  dateEnd       DateTime?

  @@index([pricelistId])
  @@index([productId])
  @@map("pricelist_lines")
}

// G-11 — Accounting period locking
model AccountingPeriod {
  id          Int      @id @default(autoincrement())
  companyId   String?
  name        String                                  // e.g. "Jan 2026"
  dateStart   DateTime
  dateStop    DateTime
  locked      Boolean  @default(false)               // true = no posting allowed
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("accounting_periods")
}

// ─────────────────────────────────────────────────────────────────────────────
// SPRINT 8 — Bank Reconciliation (G-10)
// BankStatement holds imported bank transactions; lines are matched to
// AccountMove payments via the /match endpoint.
// ─────────────────────────────────────────────────────────────────────────────

model BankStatement {
  id             Int                @id @default(autoincrement())
  name           String                              // e.g. "IBAN FR76... Jan 2026"
  journalId      Int?
  organizationId String?
  dateStart      DateTime?
  dateEnd        DateTime?
  balance        Decimal            @default(0) @db.Decimal(18,2)
  state          String             @default("open") // open | reconciled
  lines          BankStatementLine[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([organizationId])
  @@map("bank_statements")
}

model BankStatementLine {
  id               Int           @id @default(autoincrement())
  statementId      Int
  statement        BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date             DateTime
  paymentRef       String?                          // bank reference / description
  partnerId        String?
  amount           Decimal       @db.Decimal(18,2) // positive = credit, negative = debit
  accountMoveId    Int?                             // matched AccountMove (payment)
  reconciled       Boolean       @default(false)
  createdAt        DateTime      @default(now())

  @@index([statementId])
  @@index([accountMoveId])
  @@map("bank_statement_lines")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5b — ERP Foundation: Document Sequences
// Every document type gets a sequential number (SO-0001, INV-0001, etc.)
// nextval() in core/sequence uses SELECT FOR UPDATE to ensure atomicity.
// ─────────────────────────────────────────────────────────────────────────────

model IrSequence {
  id          String   @id @default(cuid())
  name        String   @unique  // e.g. "sale.order", "account.move.out_invoice"
  label       String            // human-readable "Sales Order"
  prefix      String   @default("")
  suffix      String   @default("")
  padding     Int      @default(4)
  nextNumber  Int      @default(1)
  step        Int      @default(1)
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ir_sequences")
}

// ─────────────────────────────────────────────────────────────────────────────
// PHASE 5 — AI Layer (ADR-0006: no AI auto-write to finance/legal)
// ─────────────────────────────────────────────────────────────────────────────

model AccountTax {
  id           Int      @id @default(autoincrement())
  name         String
  amount       Float    @default(0)
  amountType   String   @default("percent")   // "percent" | "fixed"
  priceInclude Boolean  @default(false)
  active       Boolean  @default(true)
  isDefault    Boolean  @default(false)        // one row may be flagged as the org default
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, isDefault])
  @@map("account_taxes")
}

model AiAction {
  id            String          @id @default(cuid())
  agentKey      String
  triggeredById String?
  triggeredBy   SpineUser?      @relation("TriggeredBy", fields: [triggeredById], references: [id])
  entityType    String
  entityId      String
  tool          String
  input         Json
  output        Json
  confidence    Float           @default(0)
  status        AiActionStatus  @default(PENDING)
  approvedById  String?
  approvedBy    SpineUser?      @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  appliedAt     DateTime?
  rolledBackAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([entityType, entityId])
  @@index([agentKey, status])
  @@index([triggeredById])
  @@map("ai_actions")
}

enum AiActionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  ROLLED_BACK
}

// ── Sprint 5 additions ────────────────────────────────────────────────────────

model HelpdeskTeam {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tickets     HelpdeskTicket[] @relation("TeamTickets")

  @@map("helpdesk_teams")
}

model AppraisalGoal {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  weight      Float        @default(1)
  deadline    DateTime?
  progress    Int          @default(0)
  tag         String?
  appraisalId Int
  employeeId  Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  appraisal   HrAppraisal  @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  employee    HrEmployee   @relation(fields: [employeeId], references: [id])

  @@map("appraisal_goals")
}

model MrpEcoLine {
  id          Int        @id @default(autoincrement())
  ecoId       Int
  action      String     @default("change") // add | remove | change
  productId   String
  newQty      Float      @default(1)
  bomLineId   Int?
  createdAt   DateTime   @default(now())
  eco         MrpEco     @relation(fields: [ecoId], references: [id], onDelete: Cascade)
  product     Product    @relation("EcoLineProduct", fields: [productId], references: [id])
  bomLine     MrpBomLine? @relation(fields: [bomLineId], references: [id])

  @@map("mrp_eco_lines")
}

model MailMessageReaction {
  id         Int         @id @default(autoincrement())
  emoji      String
  authorId   String?
  messageId  Int
  createdAt  DateTime    @default(now())
  message    MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, emoji, authorId])
  @@map("mail_message_reactions")
}

model HrRecruitmentStage {
  id           Int           @id @default(autoincrement())
  name         String
  sequence     Int           @default(10)
  requirements String?
  foldedKanban Boolean       @default(false)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  applicants   HrApplicant[] @relation("StageApplicants")

  @@map("hr_recruitment_stages")
}

// ── Sign / e-Signature module ──────────────────────────────────────────────────
model SignRequest {
  id                   Int          @id @default(autoincrement())
  documentTitle        String
  documentUrl          String?
  status               String       @default("pending") // pending|in_progress|signed|rejected|approved|expired
  dueDate              DateTime?
  createdBy            String?
  isUrgent             Boolean      @default(false)
  requiresWitness      Boolean      @default(false)
  witnessEmail         String?
  witnessName          String?
  witnessSignedAt      DateTime?
  witnessSignatureData String?      @db.Text
  witnessIpAddress     String?
  message              String?
  metadata             Json?        @default("{}")
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  signers              SignSigner[]

  @@map("sign_requests")
}

model SignSigner {
  id                 Int         @id @default(autoincrement())
  requestId          Int
  name               String
  email              String
  role               String      @default("other") // client|service_provider|employee|hr_manager|witness|other
  status             String      @default("pending") // pending|signed|rejected
  signedAt           DateTime?
  signatureData      String?     @db.Text
  signatureMethod    String?     // draw|type|upload
  ipAddress          String?
  verificationStatus String?     // pending|verified|failed
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  request            SignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("sign_signers")
}

// ── SPRINT 19 — Documents Module ─────────────────────────────────────────────

model DocumentWorkspace {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  color       String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  documents   IrDocument[]

  @@map("document_workspaces")
}

model IrDocument {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?
  mimeType      String?
  fileUrl       String?
  fileSize      Int?
  workspaceId   Int?
  tags          String[]
  isPublic      Boolean            @default(false)
  ownerId       String?            // SpineUser.id
  deletedAt     DateTime?          // soft delete
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     DocumentWorkspace? @relation(fields: [workspaceId], references: [id])

  @@map("ir_documents")
}

model StudioPage {
  id             Int       @id @default(autoincrement())
  name           String
  slug           String    @unique
  content        String    @default("")
  metaTitle      String?
  metaDescription String?
  state          String    @default("draft")  // draft, published
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

