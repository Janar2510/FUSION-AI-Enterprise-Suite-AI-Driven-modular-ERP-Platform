generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Partner {
  id                  Int                   @id @default(autoincrement())
  name                String
  email               String?
  phone               String?
  mobile              String?
  website             String?
  vat                 String?
  isCompany           Boolean               @default(false)
  type                String                @default("contact")
  street              String?
  street2             String?
  city                String?
  state               String?
  zip                 String?
  country             String?
  title               String?
  jobPosition         String?
  notes               String?
  image               String?
  lang                String?               @default("en")
  color               Int                   @default(0)
  active              Boolean               @default(true)
  isCustomer          Boolean               @default(false)
  isVendor            Boolean               @default(false)
  parentId            Int?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tags                PartnerToPartnerTag[]
  invoices            AccountMove[]         @relation("InvoicePartner")
  calendarEvents      CalendarAttendee[]
  crmLeads            CrmLead[]
  fsTasks             FsTask[]
  helpdeskTickets     HelpdeskTicket[]
  employeeLink        HrEmployee?
  parent              Partner?              @relation("CompanyContacts", fields: [parentId], references: [id])
  children            Partner[]             @relation("CompanyContacts")
  purchaseOrders      PurchaseOrder[]
  rentalOrders        RentalOrder[]
  saleOrders          SaleOrder[]
  subscriptions       Subscription[]
  pickings            StockPicking[]
  loyaltyCard         LoyaltyCard?
  passkeys            UserPasskey[]
  spreadsheets        Spreadsheet[]
  vendorPricelists    VendorPricelist[]

  @@map("partners")
}

model UserPasskey {
  id           Int      @id @default(autoincrement())
  partnerId    Int
  credentialId String   @unique
  publicKey    String
  counter      Int      @default(0)
  createdAt    DateTime @default(now())
  partner      Partner  @relation(fields: [partnerId], references: [id])

  @@map("user_passkeys")
}

model PartnerTag {
  id                  Int                   @id @default(autoincrement())
  name                String
  color               Int                   @default(0)
  PartnerToPartnerTag PartnerToPartnerTag[]

  @@map("partner_tags")
}

model CrmStage {
  id           Int       @id @default(autoincrement())
  name         String
  sequence     Int       @default(10)
  foldedKanban Boolean   @default(false)
  leads        CrmLead[]

  @@map("crm_stages")
}

model CrmTag {
  id    Int       @id @default(autoincrement())
  name  String
  color Int       @default(0)
  leads CrmLead[] @relation("CrmLeadToCrmTag")

  @@map("crm_tags")
}

model CrmLead {
  id              Int         @id @default(autoincrement())
  name            String
  type            String      @default("lead")
  active          Boolean     @default(true)
  priority        Int         @default(0)
  expectedRevenue Float       @default(0)
  probability     Float       @default(10)
  contactName     String?
  emailFrom       String?
  phone           String?
  mobile          String?
  street          String?
  city            String?
  state           String?
  zip             String?
  country         String?
  website         String?
  description     String?
  lostReason      String?
  color           Int         @default(0)
  stageId         Int
  partnerId       Int?
  dateDeadline    DateTime?
  dateClosed      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  partner         Partner?    @relation(fields: [partnerId], references: [id])
  stage           CrmStage    @relation(fields: [stageId], references: [id])
  saleOrders      SaleOrder[]
  tags            CrmTag[]    @relation("CrmLeadToCrmTag")

  @@map("crm_leads")
}

model SaleOrder {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  state         String          @default("draft")
  dateOrder     DateTime        @default(now())
  validityDate  DateTime?
  note          String?
  amountUntaxed Float           @default(0)
  amountTax     Float           @default(0)
  amountTotal   Float           @default(0)
  partnerId     Int
  crmLeadId     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  invoices      AccountMove[]   @relation("SaleInvoices")
  lines         SaleOrderLine[]
  crmLead       CrmLead?        @relation(fields: [crmLeadId], references: [id])
  partner       Partner         @relation(fields: [partnerId], references: [id])
  pickings      StockPicking[]

  @@map("sale_orders")
}

model SaleOrderLine {
  id            Int       @id @default(autoincrement())
  sequence      Int       @default(10)
  name          String
  productQty    Float     @default(1)
  priceUnit     Float     @default(0)
  discount      Float     @default(0)
  priceSubtotal Float     @default(0)
  priceTotal    Float     @default(0)
  orderId       Int
  productId     Int?
  product       Product?  @relation(fields: [productId], references: [id])
  order         SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("sale_order_lines")
}

model PurchaseOrder {
  id            Int                 @id @default(autoincrement())
  name          String              @unique
  state         String              @default("draft")
  partnerRef    String?
  dateOrder     DateTime            @default(now())
  dateApprove   DateTime?
  datePlanned   DateTime?
  note          String?
  amountUntaxed Float               @default(0)
  amountTax     Float               @default(0)
  amountTotal   Float               @default(0)
  partnerId     Int
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         PurchaseOrderLine[]
  partner       Partner             @relation(fields: [partnerId], references: [id])
  pickings      StockPicking[]

  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id            Int           @id @default(autoincrement())
  sequence      Int           @default(10)
  name          String
  productQty    Float         @default(1)
  qtyReceived   Float         @default(0)
  qtyInvoiced   Float         @default(0)
  priceUnit     Float         @default(0)
  priceSubtotal Float         @default(0)
  priceTotal    Float         @default(0)
  orderId       Int
  productId     Int?
  product       Product?      @relation(fields: [productId], references: [id])
  order         PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_lines")
}

model ProductCategory {
  id       Int               @id @default(autoincrement())
  name     String
  parentId Int?
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")
  products Product[]

  @@map("product_categories")
}

model Product {
  id              Int                 @id @default(autoincrement())
  name            String
  internalRef     String?
  barcode         String?
  type            String              @default("consu")
  salePrice       Float               @default(0)
  costPrice       Float               @default(0)
  description     String?
  descriptionSale String?
  image           String?
  active          Boolean             @default(true)
  weight          Float               @default(0)
  volume          Float               @default(0)
  categoryId      Int?
  qtyOnHand       Float               @default(0)
  qtyForecasted   Float               @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  invoiceLines    AccountMoveLine[]
  mrpLines        MrpBomLine[]
  mrpProductions  MrpProduction[]
  posLines        PosOrderLine[]
  category        ProductCategory?    @relation(fields: [categoryId], references: [id])
  purchaseLines   PurchaseOrderLine[]
  rentals         RentalOrderLine[]   @relation("RentalProductLink")
  saleLines       SaleOrderLine[]
  moves           StockMove[]
  quants          StockQuant[]
  qualityChecks   QualityCheck[]
  qualityPoints   QualityPoint[]
  mrpEcos         MrpEco[]
  webCartItems    WebCartItem[]
  orderpoints     StockWarehouseOrderpoint[]
  vendorPricelists VendorPricelist[]
  routes          StockRoute[]      @relation("ProductStockRoute")

  @@map("products")
}

model WebCart {
  id          Int            @id @default(autoincrement())
  sessionId   String         @unique
  customerId  Int?
  status      String         @default("active")
  subtotal    Float          @default(0)
  taxAmount   Float          @default(0)
  discount    Float          @default(0)
  totalAmount Float          @default(0)
  items       WebCartItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("web_carts")
}

model WebCartItem {
  id          Int      @id @default(autoincrement())
  cartId      Int
  productId   Int
  productName String
  productSku  String?
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  lineTotal   Float    @default(0)
  cart        WebCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("web_cart_items")
}

model WebOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  saleOrderId  Int?
  cartId       Int?
  gatewayStatus String   @default("pending")
  createdAt    DateTime @default(now())

  @@map("web_orders")
}

model LoyaltyProgram {
  id              Int             @id @default(autoincrement())
  name            String
  pointsPerDollar Float           @default(1)
  active          Boolean         @default(true)
  cards           LoyaltyCard[]
  rewards         LoyaltyReward[]

  @@map("loyalty_programs")
}

model LoyaltyCard {
  id         Int            @id @default(autoincrement())
  programId  Int
  partnerId  Int            @unique
  points     Float          @default(0)
  program    LoyaltyProgram @relation(fields: [programId], references: [id])
  partner    Partner        @relation(fields: [partnerId], references: [id])

  @@map("loyalty_cards")
}

model LoyaltyReward {
  id          Int            @id @default(autoincrement())
  name        String
  pointsCost  Float
  rewardType  String         @default("discount")
  programId   Int
  program     LoyaltyProgram @relation(fields: [programId], references: [id])

  @@map("loyalty_rewards")
}


model StockLocation {
  id               Int                @id @default(autoincrement())
  name             String
  completeName     String
  usage            String             @default("internal") // supplier, view, internal, customer, inventory, production, transit
  active           Boolean            @default(true)
  locationId       Int? // Parent location
  warehouseId      Int?
  companyId        Int?
  parent           StockLocation?     @relation("LocationHierarchy", fields: [locationId], references: [id])
  children         StockLocation[]    @relation("LocationHierarchy")
  warehouse        StockWarehouse?    @relation(fields: [warehouseId], references: [id])
  pickingsSrc      StockPicking[]     @relation("PickingSourceLocation")
  pickingsDest     StockPicking[]     @relation("PickingDestLocation")
  movesSrc         StockMove[]        @relation("MoveSourceLocation")
  movesDest        StockMove[]        @relation("MoveDestLocation")
  quants           StockQuant[]
  pickingTypesSrc  StockPickingType[] @relation("PickingTypeSourceLocation")
  pickingTypesDest StockPickingType[] @relation("PickingTypeDestLocation")
  orderpoints      StockWarehouseOrderpoint[]
  rulesSrc         StockRule[]        @relation("RuleSource")
  rulesDest        StockRule[]        @relation("RuleDest")

  @@map("stock_locations")
}

model StockWarehouse {
  id           Int                @id @default(autoincrement())
  name         String
  code         String             @unique
  active       Boolean            @default(true)
  locations    StockLocation[]
  pickings     StockPicking[]
  pickingTypes StockPickingType[]
  orderpoints  StockWarehouseOrderpoint[]

  @@map("stock_warehouses")
}

model StockPickingType {
  id                    Int             @id @default(autoincrement())
  name                  String
  code                  String // incoming, outgoing, internal
  sequenceCode          String
  warehouseId           Int?
  defaultLocationSrcId  Int?
  defaultLocationDestId Int?
  warehouse             StockWarehouse? @relation(fields: [warehouseId], references: [id])
  defaultLocationSrc    StockLocation?  @relation("PickingTypeSourceLocation", fields: [defaultLocationSrcId], references: [id])
  defaultLocationDest   StockLocation?  @relation("PickingTypeDestLocation", fields: [defaultLocationDestId], references: [id])
  pickings              StockPicking[]

  @@map("stock_picking_types")
}

model StockPicking {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  pickingTypeId   Int
  state           String    @default("draft")
  scheduledDate   DateTime?
  dateDone        DateTime?
  origin          String?
  note            String?
  locationId      Int?
  locationDestId  Int?
  partnerId       Int?
  warehouseId     Int?
  saleOrderId     Int?
  purchaseOrderId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pickingType   StockPickingType @relation(fields: [pickingTypeId], references: [id])
  location      StockLocation?   @relation("PickingSourceLocation", fields: [locationId], references: [id])
  locationDest  StockLocation?   @relation("PickingDestLocation", fields: [locationDestId], references: [id])
  partner       Partner?         @relation(fields: [partnerId], references: [id])
  moves         StockMove[]
  purchaseOrder PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  saleOrder     SaleOrder?       @relation(fields: [saleOrderId], references: [id])
  warehouse     StockWarehouse?  @relation(fields: [warehouseId], references: [id])
  qualityChecks QualityCheck[]

  @@map("stock_pickings")
}

model StockMove {
  id             Int      @id @default(autoincrement())
  name           String
  state          String   @default("draft")
  productQty     Float    @default(0) // Demand
  qtyDone        Float    @default(0) // Done
  locationId     Int
  locationDestId Int
  pickingId      Int?
  productId      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location     StockLocation @relation("MoveSourceLocation", fields: [locationId], references: [id])
  locationDest StockLocation @relation("MoveDestLocation", fields: [locationDestId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  picking      StockPicking? @relation(fields: [pickingId], references: [id], onDelete: Cascade)

  @@map("stock_moves")
}

model StockQuant {
  id               Int      @id @default(autoincrement())
  productId        Int
  locationId       Int
  quantity         Float    @default(0) // On Hand
  reservedQuantity Float    @default(0)
  inDate           DateTime @default(now())

  product  Product       @relation(fields: [productId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId])
  @@map("stock_quants")
}

model AccountAccount {
  id          Int               @id @default(autoincrement())
  name        String
  code        String            @unique
  accountType String
  reconcile   Boolean           @default(false)
  deprecated  Boolean           @default(false)
  active      Boolean           @default(true)
  lines       AccountMoveLine[]
  journals    AccountJournal[]  @relation("JournalDefaultAccount")

  @@map("account_accounts")
}

model AccountJournal {
  id               Int             @id @default(autoincrement())
  name             String
  code             String          @unique
  type             String
  active           Boolean         @default(true)
  defaultAccountId Int?
  defaultAccount   AccountAccount? @relation("JournalDefaultAccount", fields: [defaultAccountId], references: [id])
  moves            AccountMove[]

  @@map("account_journals")
}

model AccountMove {
  id             Int               @id @default(autoincrement())
  name           String            @unique
  moveType       String
  state          String            @default("draft")
  date           DateTime          @default(now())
  dueDate        DateTime?
  ref            String?
  amountUntaxed  Float             @default(0)
  amountTax      Float             @default(0)
  amountTotal    Float             @default(0)
  amountResidual Float             @default(0)
  paymentState   String            @default("not_paid")
  journalId      Int
  partnerId      Int?
  saleOrderId    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lines          AccountMoveLine[]
  saleOrder      SaleOrder?        @relation("SaleInvoices", fields: [saleOrderId], references: [id])
  partner        Partner?          @relation("InvoicePartner", fields: [partnerId], references: [id])
  journal        AccountJournal    @relation(fields: [journalId], references: [id])

  @@map("account_moves")
}

model AccountMoveLine {
  id            Int             @id @default(autoincrement())
  name          String
  quantity      Float           @default(1)
  priceUnit     Float           @default(0)
  priceSubtotal Float           @default(0)
  priceTotal    Float           @default(0)
  debit         Float           @default(0)
  credit        Float           @default(0)
  balance       Float           @default(0)
  reconciled    Boolean         @default(false)
  accountId     Int?
  account       AccountAccount? @relation(fields: [accountId], references: [id])
  moveId        Int
  productId     Int?
  product       Product?        @relation(fields: [productId], references: [id])
  move          AccountMove     @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@map("account_move_lines")
}

model FsTask {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  state         String      @default("new")
  priority      Int         @default(0)
  scheduledDate DateTime?
  dateDeadline  DateTime?
  partnerId     Int?
  employeeId    Int?
  street        String?
  city          String?
  zip           String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  employee      HrEmployee? @relation(fields: [employeeId], references: [id])
  partner       Partner?    @relation(fields: [partnerId], references: [id])

  @@map("fs_tasks")
}

model RentalOrder {
  id          Int               @id @default(autoincrement())
  name        String
  state       String            @default("draft")
  pickupDate  DateTime
  returnDate  DateTime
  partnerId   Int
  amountTotal Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  lines       RentalOrderLine[]
  partner     Partner           @relation(fields: [partnerId], references: [id])

  @@map("rental_orders")
}

model RentalOrderLine {
  id            Int         @id @default(autoincrement())
  orderId       Int
  productId     Int
  productQty    Int         @default(1)
  priceUnit     Float       @default(0)
  priceSubtotal Float       @default(0)
  product       Product     @relation("RentalProductLink", fields: [productId], references: [id])
  order         RentalOrder @relation(fields: [orderId], references: [id])

  @@map("rental_order_lines")
}

model HrDepartment {
  id         Int            @id @default(autoincrement())
  name       String
  active     Boolean        @default(true)
  color      Int            @default(0)
  parentId   Int?
  managerId  Int?           @unique
  applicants HrApplicant[]
  manager    HrEmployee?    @relation("DeptManager", fields: [managerId], references: [id])
  parent     HrDepartment?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children   HrDepartment[] @relation("DeptHierarchy")
  employees  HrEmployee[]   @relation("DeptEmployees")

  @@map("hr_departments")
}

model HrJob {
  id                Int           @id @default(autoincrement())
  name              String
  description       String?
  expectedEmployees Int           @default(1)
  noOfEmployee      Int           @default(0)
  state             String        @default("recruit")
  applicants        HrApplicant[]
  employees         HrEmployee[]

  @@map("hr_jobs")
}

model HrEmployee {
  id               Int            @id @default(autoincrement())
  name             String
  employeeNumber   String?
  workEmail        String?
  workPhone        String?
  mobilePhone      String?
  birthday         DateTime?
  gender           String?
  maritalStatus    String?
  emergencyContact String?
  emergencyPhone   String?
  image            String?
  active           Boolean        @default(true)
  color            Int            @default(0)
  departmentId     Int?
  jobId            Int?
  partnerId        Int?           @unique
  managerId        Int?
  coachId          Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  fsTasks          FsTask[]
  appraisals       HrAppraisal[]
  attendances      HrAttendance[]
  managedDept      HrDepartment?  @relation("DeptManager")
  manager          HrEmployee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates     HrEmployee[]   @relation("EmployeeManager")
  coach            HrEmployee?    @relation("EmployeeCoach", fields: [coachId], references: [id])
  coachees         HrEmployee[]   @relation("EmployeeCoach")
  partner          Partner?       @relation(fields: [partnerId], references: [id])
  job              HrJob?         @relation(fields: [jobId], references: [id])
  department       HrDepartment?  @relation("DeptEmployees", fields: [departmentId], references: [id])
  expenses         HrExpense[]
  leaveRequests    HrLeave[]
  payslips         HrPayslip[]
  skills           HrEmployeeSkill[]
  planningSlots    PlanningSlot[]
  timesheets       HrTimesheet[]

  @@map("hr_employees")
}

model HrSkill {
  id          Int               @id @default(autoincrement())
  name        String            @unique
  description String?
  employees   HrEmployeeSkill[]

  @@map("hr_skills")
}

model HrEmployeeSkill {
  id         Int        @id @default(autoincrement())
  employeeId Int
  skillId    Int
  level      String     @default("intermediate") // beginner, intermediate, expert
  employee   HrEmployee @relation(fields: [employeeId], references: [id])
  skill      HrSkill    @relation(fields: [skillId], references: [id])

  @@map("hr_employee_skills")
}

model HrTimesheet {
  id         Int             @id @default(autoincrement())
  date       DateTime        @default(now())
  name       String
  unitAmount Float           @default(0)
  employeeId Int
  taskId     Int?
  projectId  Int?
  project    ProjectProject? @relation(fields: [projectId], references: [id])
  task       ProjectTask?    @relation(fields: [taskId], references: [id])
  employee   HrEmployee      @relation(fields: [employeeId], references: [id])

  @@map("hr_timesheets")
}

model HrLeave {
  id           Int        @id @default(autoincrement())
  name         String?
  state        String     @default("draft")
  leaveType    String     @default("legal")
  dateFrom     DateTime
  dateTo       DateTime
  numberOfDays Float      @default(1)
  notes        String?
  employeeId   Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  employee     HrEmployee @relation(fields: [employeeId], references: [id])

  @@map("hr_leaves")
}

model HrExpense {
  id          Int        @id @default(autoincrement())
  name        String
  date        DateTime   @default(now())
  state       String     @default("draft")
  totalAmount Float      @default(0)
  quantity    Float      @default(1)
  unitAmount  Float      @default(0)
  description String?
  paymentMode String     @default("own_account")
  receipt     String?
  employeeId  Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employee    HrEmployee @relation(fields: [employeeId], references: [id])

  @@map("hr_expenses")
}

model ProjectStage {
  id           Int           @id @default(autoincrement())
  name         String
  sequence     Int           @default(10)
  foldedKanban Boolean       @default(false)
  tasks        ProjectTask[]

  @@map("project_stages")
}

model ProjectProject {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  color         Int            @default(0)
  active        Boolean        @default(true)
  dateStart     DateTime?
  date          DateTime?
  taskCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  timesheets    HrTimesheet[]
  planningSlots PlanningSlot[]
  tasks         ProjectTask[]

  @@map("project_projects")
}

model ProjectTask {
  id           Int            @id @default(autoincrement())
  name         String
  description  String?
  priority     Int            @default(0)
  sequence     Int            @default(10)
  color        Int            @default(0)
  active       Boolean        @default(true)
  dateDeadline DateTime?
  dateEnd      DateTime?
  kanbanState  String         @default("normal")
  stageId      Int
  projectId    Int
  parentId     Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  timesheets   HrTimesheet[]
  parent       ProjectTask?   @relation("TaskHierarchy", fields: [parentId], references: [id])
  subtasks     ProjectTask[]  @relation("TaskHierarchy")
  project      ProjectProject @relation(fields: [projectId], references: [id])
  stage        ProjectStage   @relation(fields: [stageId], references: [id])

  @@map("project_tasks")
}

model HelpdeskStage {
  id           Int              @id @default(autoincrement())
  name         String
  sequence     Int              @default(10)
  foldedKanban Boolean          @default(false)
  tickets      HelpdeskTicket[]

  @@map("helpdesk_stages")
}

model HelpdeskTicket {
  id           Int           @id @default(autoincrement())
  name         String
  description  String?
  priority     Int           @default(0)
  kanbanState  String        @default("normal")
  active       Boolean       @default(true)
