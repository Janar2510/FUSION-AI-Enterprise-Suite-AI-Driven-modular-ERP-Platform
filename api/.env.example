# Copy to .env and fill in real values — never commit .env
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fusionai:fusionai_secret@localhost:5432/fusionai
DATABASE_URL_TEST=postgresql://fusionai:fusionai_secret@localhost:5432/fusionai_test
SESSION_SECRET=change-me-in-production-32-chars-minimum
JWT_SECRET=change-me-in-production-32-chars-minimum
CORS_ORIGIN=http://localhost:5173

# Workflow CRON triggers: re-scan DB-backed CRON workflows (ms). Omit for default 120000; minimum 5000 if set.
# WORKFLOW_CRON_REFRESH_MS=120000

# Optional: persist outbound automation WEBHOOK deliveries in Postgres and drain via background worker (DLQ after max attempts).
# Inline config.hmacSecret cannot be queued — those stay synchronous.
# AUTOMATION_WEBHOOK_QUEUE=1
# AUTOMATION_WEBHOOK_QUEUE_POLL_MS=15000
# AUTOMATION_WEBHOOK_QUEUE_BATCH=
