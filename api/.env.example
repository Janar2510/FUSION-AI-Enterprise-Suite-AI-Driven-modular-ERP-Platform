# Copy to .env and fill in real values — never commit .env
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://fusionai:fusionai_secret@localhost:5432/fusionai
DATABASE_URL_TEST=postgresql://fusionai:fusionai_secret@localhost:5432/fusionai_test
